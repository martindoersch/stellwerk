{
  "_hinweis": "Belegung Loupedeck+ → Capture One. Namen = Beschriftungen aus learn_loupedeck.swift. IDs siehe docs/capture-one-controls.md. perTick = Wertänderung pro Rasterschritt (ohne Beschleunigung). Drücken eines Drehreglers setzt seinen Regler zurück.",
  "app": "Capture One",
  "acceleration": { "fastMs": 20, "fastFactor": 4, "mediumMs": 45, "mediumFactor": 2 },
  "modifiers": { "fine": 0.2, "coarse": 4, "keyboard": true, "_hinweis": "Wie Photoshop: Alt/⌥ halten = fein, Shift/⇧ halten = grob. Mac-Tastatur immer, Loupedeck-Tasten Alt/Shift im Modifier-Modus" },
  "modeKeys": {
    "_hinweis": "--/Clr wechselt die fünf Tasten zwischen Sternen und Farben; Fn + --/Clr = Modifier-Modus (Shift/Ctrl/Cmd/Alt/Tab). Fn + Taste = Sterne/Farbe löschen",
    "toggle": "--/Clr (Sterne/Farben)",
    "fn": "Fn",
    "keys":   ["Shift", "Ctrl", "Cmd", "Alt", "Tab"],
    "stars":  ["0x101", "0x102", "0x103", "0x104", "0x105"], "starsClear": "0x106",
    "colors": ["0x107", "0x109", "0x10A", "0x10B", "0x10D"], "colorsClear": "0x10E"
  },
  "dials": {
    "Exposure":             { "param": "0x26",  "perTick": 0.02 },
    "Contrast":             { "param": "0x28",  "perTick": 0.5 },
    "Clarity":              { "param": "0x32",  "perTick": 1 },
    "Shadows":              { "param": "0x30",  "perTick": 1 },
    "Highlights":           { "param": "0x2E",  "perTick": 1 },
    "Whites":               { "param": "0x250", "perTick": 1 },
    "Blacks":               { "param": "0x251", "perTick": 1 },
    "Vibrance":             { "param": "0x33",  "perTick": 1, "_hinweis": "Capture One hat über Tangent keine Dynamik → Struktur" },
    "Saturation":           { "param": "0x2C",  "perTick": 1 },
    "White Balance / Temp": { "param": "0x01",  "perTick": 20 },
    "Tint":                 { "param": "0x03",  "perTick": 0.3 },
    "D1":                   { "param": "0x2A",  "perTick": 0.5, "_hinweis": "Helligkeit" },
    "D2":                   { "param": "0x37",  "perTick": 0.02, "_hinweis": "Vignettierung" },
    "Control Dial (großes Rad)": { "plus": "0x8E", "minus": "0x8D", "_hinweis": "nächstes / voriges Bild" },
    "Farbregler 1 (Rot)":     { "param": "0x0E", "perTick": 0.5, "_hinweis": "Farbbalance Gesamt X (Tangent hat kein HSL pro Farbe)" },
    "Farbregler 2 (Orange)":  { "param": "0x0F", "perTick": 0.5, "_hinweis": "Farbbalance Gesamt Y" },
    "Farbregler 3 (Gelb)":    { "param": "0x05", "perTick": 0.5, "_hinweis": "Farbbalance Schatten X" },
    "Farbregler 4 (Grün)":    { "param": "0x06", "perTick": 0.5, "_hinweis": "Farbbalance Schatten Y" },
    "Farbregler 5 (Aqua)":    { "param": "0x08", "perTick": 0.5, "_hinweis": "Farbbalance Mitteltöne X" },
    "Farbregler 6 (Blau)":    { "param": "0x09", "perTick": 0.5, "_hinweis": "Farbbalance Mitteltöne Y" },
    "Farbregler 7 (Lila)":    { "param": "0x0B", "perTick": 0.5, "_hinweis": "Farbbalance Lichter X" },
    "Farbregler 8 (Magenta)": { "param": "0x0C", "perTick": 0.5, "_hinweis": "Farbbalance Lichter Y" }
  },
  "bwLayer": {
    "_hinweis": "Clr/BW schaltet Schwarzweiß ein/aus (0x11) und belegt die Farbregler mit den SW-Reglern; Orange/Lila = Tönung Lichter/Schatten (Sättigung)",
    "toggle": "Clr/BW",
    "action": "0x11",
    "dials": {
      "Farbregler 1 (Rot)":     { "param": "0x12", "perTick": 1 },
      "Farbregler 2 (Orange)":  { "param": "0x20", "perTick": 1, "_hinweis": "SW Tönung Lichter Sättigung" },
      "Farbregler 3 (Gelb)":    { "param": "0x14", "perTick": 1 },
      "Farbregler 4 (Grün)":    { "param": "0x16", "perTick": 1 },
      "Farbregler 5 (Aqua)":    { "param": "0x18", "perTick": 1 },
      "Farbregler 6 (Blau)":    { "param": "0x1A", "perTick": 1 },
      "Farbregler 7 (Lila)":    { "param": "0x24", "perTick": 1, "_hinweis": "SW Tönung Schatten Sättigung" },
      "Farbregler 8 (Magenta)": { "param": "0x1C", "perTick": 1 }
    }
  },
  "fnButtons": {
    "_hinweis": "Fn gedrückt halten + Taste",
    "Undo":         { "action": "0x112", "_hinweis": "Anpassungen zurücksetzen (Martin)" }
  },
  "buttons": {
    "Undo":         { "keys": "cmd+z", "_hinweis": "Tangent hat kein Undo (0x77 getestet: wirkungslos) → Tastenkürzel" },
    "Redo":         { "keys": "cmd+shift+z", "_hinweis": "Tangent-Redo 0x78 getestet: wirkungslos → Menü/Tastenkürzel" },
    "Copy":         { "action": "0xFC" },
    "Paste":        { "keys": "cmd+shift+v", "_hinweis": "Tangent 0xFD öffnete Dialog „Anpassungen einfügen\" und hing → Menü. Alternative zum Testen: a 0x16D" },
    "Before/After": { "action": "0x252" },
    "Screen Mode":  { "action": "0xF7" },
    "Pfeil links":  { "action": "0x8D" },
    "Pfeil rechts": { "action": "0x8E" },
    "Pfeil oben":   { "action": "0xC5", "_hinweis": "Zoom 100 %" },
    "Pfeil unten":  { "action": "0xC4", "_hinweis": "Zoom einpassen" },
    "Export":       { "keys": "cmd+d", "_hinweis": "Martins Vorgabe ⌘D, über das Menü" },
    "P1":           { "action": "0x111", "_hinweis": "Auto" },
    "P2":           { "action": "0x112", "_hinweis": "Anpassungen zurücksetzen" },
    "P3":           { "action": "0xF9",  "_hinweis": "nach links drehen" },
    "P4":           { "action": "0xFA",  "_hinweis": "nach rechts drehen" },
    "P5":           { "action": "0xCB",  "_hinweis": "Belichtungswarnung ein/aus" },
    "P6":           { "action": "0xCD",  "_hinweis": "Fokusmaske ein/aus" },
    "P7":           { "action": "0x114", "_hinweis": "neue Variante" },
    "P8":           { "action": "0x115", "_hinweis": "Variante klonen" },
    "C1":           { "keys": "return", "_hinweis": "Enter (Martin), z. B. Zuschneiden bestätigen, Dialoge" },
    "C2":           { "keys": "esc", "_hinweis": "Esc (Martin), abbrechen" },
    "C3":           { "action": "0x15B", "_hinweis": "Weißabgleich-Pipette" },
    "C4":           { "action": "0x176", "_hinweis": "Maske malen" },
    "C5":           { "keys": "cmd+shift+d", "_hinweis": "⇧⌘D (Martin)" },
    "C6":           { "keys": "cmd+d", "_hinweis": "⌘D (Martin)" },
    "L1":           { "action": "0x21D", "_hinweis": "neue leere Ebene" },
    "L2":           { "action": "0x21B", "_hinweis": "nächste Ebene (nach oben)" },
    "L3":           { "action": "0x243", "_hinweis": "Ebene ein/aus" }
  }
}
