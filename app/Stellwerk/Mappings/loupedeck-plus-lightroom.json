{
  "_hinweis": "Belegung Loupedeck+ → Lightroom Classic (über das Stellwerk-Plug-in, gilt im Modus „Im aktiven Programm“, wenn Lightroom vorne ist). Regler/Aktionen = Namen aus LightroomControls (Output/LightroomBridge.swift). Ganzzahlige Regler: perTick mindestens 1. Drücken eines Drehreglers setzt seinen Regler zurück.",
  "app": "Lightroom Classic",
  "acceleration": { "fastMs": 20, "fastFactor": 4, "mediumMs": 45, "mediumFactor": 2 },
  "modifiers": { "fine": 0.2, "coarse": 4, "keyboard": true },
  "modeKeys": {
    "_hinweis": "--/Clr wechselt die fünf Tasten zwischen Sternen und Farbmarkierungen (umschalten); Fn + --/Clr = Modifier-Modus. Fn + Taste im Sterne-Modus = Sterne löschen",
    "toggle": "--/Clr (Sterne/Farben)",
    "fn": "Fn",
    "keys":   ["Shift", "Ctrl", "Cmd", "Alt", "Tab"],
    "stars":  ["rating1", "rating2", "rating3", "rating4", "rating5"], "starsClear": "rating0",
    "colors": ["red", "yellow", "green", "blue", "purple"]
  },
  "dials": {
    "Exposure":             { "param": "Exposure2012",   "perTick": 0.02 },
    "Contrast":             { "param": "Contrast2012",   "perTick": 1 },
    "Clarity":              { "param": "Clarity2012",    "perTick": 1 },
    "Shadows":              { "param": "Shadows2012",    "perTick": 1 },
    "Highlights":           { "param": "Highlights2012", "perTick": 1 },
    "Whites":               { "param": "Whites2012",     "perTick": 1 },
    "Blacks":               { "param": "Blacks2012",     "perTick": 1 },
    "Vibrance":             { "param": "Vibrance",       "perTick": 1 },
    "Saturation":           { "param": "Saturation",     "perTick": 1 },
    "White Balance / Temp": { "param": "Temperature",    "perTick": 20, "_hinweis": "Raw: Kelvin; JPEG: −100…100" },
    "Tint":                 { "param": "Tint",           "perTick": 1 },
    "D1":                   { "param": "Texture",        "perTick": 1 },
    "D2":                   { "param": "Dehaze",         "perTick": 1 },
    "Control Dial (großes Rad)": { "plus": "next", "minus": "previous", "_hinweis": "nächstes / voriges Bild" }
  },
  "layers": {
    "_hinweis": "Hue/Sat/Lum schalten die acht Farbregler auf HSL Farbton/Sättigung/Luminanz der jeweiligen Farbe (wie in der Loupedeck-Software); ohne Wahl: default",
    "default": "Sat",
    "Hue": {
      "label": "Farbton",
      "dials": {
        "Farbregler 1 (Rot)": { "param": "HueAdjustmentRed", "perTick": 1 },
        "Farbregler 2 (Orange)": { "param": "HueAdjustmentOrange", "perTick": 1 },
        "Farbregler 3 (Gelb)": { "param": "HueAdjustmentYellow", "perTick": 1 },
        "Farbregler 4 (Grün)": { "param": "HueAdjustmentGreen", "perTick": 1 },
        "Farbregler 5 (Aqua)": { "param": "HueAdjustmentAqua", "perTick": 1 },
        "Farbregler 6 (Blau)": { "param": "HueAdjustmentBlue", "perTick": 1 },
        "Farbregler 7 (Lila)": { "param": "HueAdjustmentPurple", "perTick": 1 },
        "Farbregler 8 (Magenta)": { "param": "HueAdjustmentMagenta", "perTick": 1 }
      }
    },
    "Sat": {
      "label": "Sättigung",
      "dials": {
        "Farbregler 1 (Rot)": { "param": "SaturationAdjustmentRed", "perTick": 1 },
        "Farbregler 2 (Orange)": { "param": "SaturationAdjustmentOrange", "perTick": 1 },
        "Farbregler 3 (Gelb)": { "param": "SaturationAdjustmentYellow", "perTick": 1 },
        "Farbregler 4 (Grün)": { "param": "SaturationAdjustmentGreen", "perTick": 1 },
        "Farbregler 5 (Aqua)": { "param": "SaturationAdjustmentAqua", "perTick": 1 },
        "Farbregler 6 (Blau)": { "param": "SaturationAdjustmentBlue", "perTick": 1 },
        "Farbregler 7 (Lila)": { "param": "SaturationAdjustmentPurple", "perTick": 1 },
        "Farbregler 8 (Magenta)": { "param": "SaturationAdjustmentMagenta", "perTick": 1 }
      }
    },
    "Lum": {
      "label": "Luminanz",
      "dials": {
        "Farbregler 1 (Rot)": { "param": "LuminanceAdjustmentRed", "perTick": 1 },
        "Farbregler 2 (Orange)": { "param": "LuminanceAdjustmentOrange", "perTick": 1 },
        "Farbregler 3 (Gelb)": { "param": "LuminanceAdjustmentYellow", "perTick": 1 },
        "Farbregler 4 (Grün)": { "param": "LuminanceAdjustmentGreen", "perTick": 1 },
        "Farbregler 5 (Aqua)": { "param": "LuminanceAdjustmentAqua", "perTick": 1 },
        "Farbregler 6 (Blau)": { "param": "LuminanceAdjustmentBlue", "perTick": 1 },
        "Farbregler 7 (Lila)": { "param": "LuminanceAdjustmentPurple", "perTick": 1 },
        "Farbregler 8 (Magenta)": { "param": "LuminanceAdjustmentMagenta", "perTick": 1 }
      }
    }
  },
  "fnButtons": {
    "Undo":   { "keys": "cmd+shift+r", "_hinweis": "Alle Einstellungen zurücksetzen (wie Fn + Undo in Capture One)" },
    "Export": { "keys": "cmd+alt+shift+e", "_hinweis": "Mit vorherigen Einstellungen exportieren" }
  },
  "buttons": {
    "Undo":         { "action": "undo" },
    "Redo":         { "action": "redo" },
    "Copy":         { "keys": "cmd+shift+c", "_hinweis": "Einstellungen kopieren (Dialog)" },
    "Paste":        { "keys": "cmd+shift+v", "_hinweis": "Einstellungen einfügen" },
    "Before/After": { "keys": "y", "_hinweis": "Vorher/Nachher" },
    "Screen Mode":  { "keys": "f", "_hinweis": "Bildschirmmodus wechseln" },
    "Pfeil links":  { "keys": "left" },
    "Pfeil rechts": { "keys": "right" },
    "Pfeil oben":   { "keys": "up" },
    "Pfeil unten":  { "keys": "down" },
    "Export":       { "keys": "cmd+shift+e", "_hinweis": "Exportieren …" },
    "P1":           { "keys": "cmd+u", "_hinweis": "Automatisch (Auto-Tonwert)" },
    "P2":           { "keys": "cmd+shift+r", "_hinweis": "Einstellungen zurücksetzen" },
    "P5":           { "keys": "j", "_hinweis": "Beschneidungswarnung ein/aus" },
    "P7":           { "action": "pick", "_hinweis": "als Auswahl markieren" },
    "P8":           { "action": "reject", "_hinweis": "als abgelehnt markieren" },
    "C1":           { "keys": "return" },
    "C2":           { "keys": "esc" },
    "C3":           { "keys": "g", "_hinweis": "Rasteransicht (Bibliothek)" },
    "C4":           { "keys": "d", "_hinweis": "Entwickeln" },
    "C5":           { "keys": "r", "_hinweis": "Freistellen" },
    "C6":           { "keys": "shift+w", "_hinweis": "Masken" }
  }
}
